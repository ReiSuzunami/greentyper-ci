# Keep GitHub CLI state and commit identity scoped to GreenTyper.
export GREENTYPER_WORKSPACE="$PWD"
export GH_HOST="github.com"
export GH_CONFIG_DIR="$GREENTYPER_WORKSPACE/.cache/gh"

export GIT_AUTHOR_NAME="ReiSuzunami"
export GIT_AUTHOR_EMAIL="i@rei.rs"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

export CARGO_TARGET_DIR="$GREENTYPER_WORKSPACE/.cache/cargo-target"
